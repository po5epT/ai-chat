server {

    server_name ${FRONTEND_DOMAIN_NAME};
    access_log /var/log/nginx/${FRONTEND_DOMAIN_NAME}.access.log;
    error_log /var/log/nginx/${FRONTEND_DOMAIN_NAME}.error.log;

        location / {
            add_header 'Access-Control-Expose-Headers' 'access-token,client,content-type,provider,uid';
            add_header 'Access-Control-Allow-Headers' 'access-token,client,content-type,provider,uid';
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection 'upgrade';
            proxy_set_header Host $host;
            proxy_cache_bypass $http_upgrade;
            proxy_pass http://ai_front:5173;
        }
        
    listen 443 ssl default_server;
    ssl_certificate /etc/letsencrypt/live/${FRONTEND_DOMAIN_NAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${FRONTEND_DOMAIN_NAME}/privkey.pem;

}
server {
    if ($host = ${FRONTEND_DOMAIN_NAME}) {
        return 301 https://$host$request_uri;
    }

    server_name ${FRONTEND_DOMAIN_NAME};

    listen 80 default_server;
    return 404;
}